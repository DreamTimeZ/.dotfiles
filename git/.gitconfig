[core]
	eol = lf
	autocrlf = input
	editor = nvim
	excludesfile = ~/.gitignore_global
	whitespace = space-before-tab,-indent-with-non-tab,trailing-space
	trustctime = false
	untrackedCache = true
	pager = delta
	filemode = false
	fsmonitor = true

[init]
	defaultBranch = main

[color]
	ui = auto
	diff = auto
	status = auto
	branch = auto

[push]
	default = simple
	autoSetupRemote = true

[fetch]
	prune = true

[diff]
	mnemonicPrefix = true
	renames = copies
	colorMoved = default

[merge]
	log = true
	conflictstyle = zdiff3

[help]
	autocorrect = 1

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false
	features = decorations
	line-numbers = true
	wrap-max-lines = unlimited
	hyperlinks = true

# Custom features are ignored when named in `features` above (delta 0.21.2); only
# DELTA_FEATURES activates them, set from $COLUMNS in zsh modules/local/26-delta.zsh.
[delta "side-by-side-when-wide"]
	side-by-side = true

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

# Last, so machine-local values override everything above
[include]
    path = ~/.gitconfig.local
