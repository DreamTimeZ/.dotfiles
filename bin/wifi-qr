#!/usr/bin/env zsh
set -euo pipefail

# The payload follows the ZXing barcode contents format. The password is read
# from stdin with echo off, never from argv, so it stays out of shell history
# and the process table.

readonly SCRIPT_NAME="${0:t}"
readonly ERROR_CORRECTION=Q   # a print survives a smudge, the payload is short enough to afford it
readonly PNG_MODULE_SIZE=12
# qrencode auto-splits into mode segments, and those multi-segment symbols do
# not decode in OpenCV once the payload holds non-ASCII (umlaut SSIDs). One
# 8-bit segment reads back fine, so it is applied to exactly that case: on an
# ASCII payload it only blocks the compaction auto mode would do, which costs
# 0 to 2 symbol versions, 0 to 16 columns in the wide renderer below (measured
# 2026-09-11 at -l L: 0 on HOMENET/ABCDEF1234, 8 on homenet/hunter22, 16 on a
# 32-digit SSID with a 63-digit password).
readonly BYTE_MODE=-8
# A screen carries no smudge, and a higher level pushes common payloads past
# 80 columns in the wide renderer, which halves every module. The saved version
# is worth more than the redundancy here, while the png keeps Q because it is
# the one that gets printed.
readonly TERMINAL_ERROR_CORRECTION=L
readonly WIDE_CELLS_PER_MODULE=2
readonly DEFAULT_COLUMNS=80   # zsh sets COLUMNS to 0 when there is no controlling terminal
# --raw only drops zbarimg's "QR-Code:" prefix, it still transcodes: with no ECI
# in the symbol it guesses Shift-JIS for the 8-bit segment above and hands back
# "Grﾃｼﾃ歹-WLAN" for "Grüße-WLAN". -Sbinary is the switch that suppresses the
# guess and returns the bytes the symbol carries (measured 2026-09-11). It also
# drops the newline between symbols, and --oneshot is a no-op under it, so an
# image holding two codes comes back as one concatenated payload.
readonly DECODE_ARGS=(--raw --quiet -Sbinary)
readonly ZBAR_NO_SYMBOL=4
# 802.11 Annex J maps a WPA-PSK passphrase of PSK_MIN to PSK_MAX printable ASCII
# characters to the key, or takes the raw 256-bit key as PSK_HEX_LEN hex digits.
# SAE has no such limit, but the code says T:WPA and a transition-mode AP still
# derives a PSK, so a passphrase outside that would scan and then not join.
readonly PSK_MIN=8
readonly PSK_MAX=63
readonly PSK_HEX_LEN=64
readonly NOT_PRINTABLE_ASCII='*[^ -~]*'
readonly EXIT_INT=130    # 128 + signal number
readonly EXIT_TERM=143

usage() {
  print -r -u2 -- "Usage: $SCRIPT_NAME [-o FILE.png] [--] SSID"
  print -r -u2 -- "       $SCRIPT_NAME -d FILE.png"
  print -r -u2 -- "  Prompts for the password. Without -o the code is drawn in the terminal."
  print -r -u2 -- "  -d shows a saved code on the alternate screen, dropped at exit where the terminal honours it."
}

# The five characters the ZXing format escapes.
escape() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//;/\\;}
  s=${s//,/\\,}
  s=${s//:/\\:}
  s=${s//\"/\\\"}
  print -r -- "$s"
}

validate_password() {
  local pw=$1
  if [[ $pw == $~NOT_PRINTABLE_ASCII ]]; then
    print -r -u2 -- "$SCRIPT_NAME: password holds a character outside printable ASCII, which a WPA passphrase cannot"
    exit 1
  fi
  if (( ${#pw} == PSK_HEX_LEN )) && [[ $pw != *[^0-9a-fA-F]* ]]; then
    return
  fi
  if (( ${#pw} < PSK_MIN || ${#pw} > PSK_MAX )); then
    print -r -u2 -- "$SCRIPT_NAME: password is ${#pw} characters, a WPA passphrase is $PSK_MIN to $PSK_MAX"
    exit 1
  fi
}

# A decoded payload carries the password in cleartext. On a terminal it goes to
# the alternate screen buffer, which an emulator that honours it discards at
# rmcup, so the password never reaches scrollback. terminfo cannot tell whether
# the emulator honours it (GNU screen ignores it unless altscreen is on). A
# redirected stdout is the caller's own choice and is left verbatim. The symbol
# bytes are untrusted: (V) keeps them from reaching the terminal as control
# sequences.
show_transient() {
  local text=$1 tty_state
  if [[ ! -t 1 ]]; then
    print -r -- "$text"
    return
  fi
  if ! tty_state=$(stty -g 2>/dev/null </dev/tty); then
    print -r -u2 -- "$SCRIPT_NAME: no controlling terminal, this lands in scrollback"
    print -r -- "${(V)text}"
    return
  fi
  # A signal during read -k exits before read restores the tty, so the trap
  # puts the saved state back itself.
  trap 'stty "$tty_state" </dev/tty 2>/dev/null || :; tput rmcup 2>/dev/null || :; exit $EXIT_INT' INT
  trap 'stty "$tty_state" </dev/tty 2>/dev/null || :; tput rmcup 2>/dev/null || :; exit $EXIT_TERM' TERM
  if ! tput smcup 2>/dev/null; then
    trap - INT TERM
    print -r -u2 -- "$SCRIPT_NAME: terminal has no alternate screen, this lands in scrollback"
    print -r -- "${(V)text}"
    return
  fi
  tput clear 2>/dev/null || :
  print -r -- "${(V)text}"
  print -r -- ""
  print -r -- "-- press any key --"
  read -k 1 -s </dev/tty || :
  while read -k 1 -s -t </dev/tty; do :; done   # the rest of a multi-byte key
  tput rmcup 2>/dev/null || :
  trap - INT TERM
}

# ANSIUTF8 packs two module rows into one cell row, so a module lands one cell
# wide, near 8px at a typical font size, and a version 5 symbol is only about
# 3.5cm across on a laptop display: under 1mm a module, which is where a phone
# camera starts needing to be held close and retried. ANSI spends
# WIDE_CELLS_PER_MODULE cells per module instead, doubling the drawn size, and
# costs twice the width. Its output is square, so the row count gives the
# module width without parsing the colour escapes out of a line.
draw_in_terminal() {
  local payload=$1 art cols=$COLUMNS
  (( cols )) || cols=$DEFAULT_COLUMNS
  art=$(print -rn -- "$payload" | qrencode "${encode_args[@]}" -t ANSI -l "$TERMINAL_ERROR_CORRECTION")
  local -a rows=( ${(f)art} )
  if (( ${#rows} * WIDE_CELLS_PER_MODULE <= cols )); then
    print -r -- "$art"
    return
  fi
  print -rn -- "$payload" | qrencode "${encode_args[@]}" -t ANSIUTF8 -l "$TERMINAL_ERROR_CORRECTION"
}

decode() {
  local file=$1 payload rc=0
  if [[ ! -f $file ]]; then
    print -r -u2 -- "$SCRIPT_NAME: $file: no such file"
    exit 1
  fi
  if ! command -v zbarimg >/dev/null; then
    print -r -u2 -- "$SCRIPT_NAME: zbarimg not found (brew install zbar, apt install zbar-tools)"
    exit 1
  fi
  payload=$(zbarimg "${DECODE_ARGS[@]}" -- "$file") || rc=$?
  if (( rc == ZBAR_NO_SYMBOL )); then
    print -r -u2 -- "$SCRIPT_NAME: no QR code found in $file"
    exit 1
  fi
  if (( rc )); then
    print -r -u2 -- "$SCRIPT_NAME: zbarimg could not read $file"
    exit 1
  fi
  show_transient "$payload"
}

typeset -a out_arg dec_arg help_arg
zparseopts -D -F -- o:=out_arg d:=dec_arg h=help_arg -help=help_arg || { usage; exit 2; }
if (( $#help_arg )); then
  usage
  exit 0
fi
readonly out=${out_arg[2]:-}
readonly dec=${dec_arg[2]:-}
if (( $#out_arg )) && [[ -z $out ]]; then
  print -r -u2 -- "$SCRIPT_NAME: -o needs a filename"
  exit 2
fi

if (( $#dec_arg )); then
  if [[ -z $dec ]]; then
    print -r -u2 -- "$SCRIPT_NAME: -d needs a filename"
    exit 2
  fi
  if (( $#out_arg )); then
    print -r -u2 -- "$SCRIPT_NAME: -d reads a code and -o writes one, pick one"
    exit 2
  fi
  if (( $# )); then
    usage
    exit 2
  fi
  decode "$dec"
  exit 0
fi

if (( $# != 1 )) || [[ -z $1 ]]; then
  usage
  exit 2
fi
readonly ssid=$1

# qrencode cannot declare an ECI charset, so a non-ASCII payload is handed to the
# scanner as undeclared bytes and decoders guess. zbar without -Sbinary
# transcodes "Grüße-WLAN" to "Grﾃｼﾃ歹-WLAN", and did so on every one of ten
# payload shapes tried, 30 to 93 bytes, one to seven umlauts (measured
# 2026-09-11), so the failure is silent. The password is validated ASCII and
# escape only adds backslashes, so the SSID alone decides whether the payload
# needs the 8-bit segment.
typeset -a encode_args=()
if [[ $ssid == $~NOT_PRINTABLE_ASCII ]]; then
  print -r -u2 -- "$SCRIPT_NAME: SSID holds a character outside printable ASCII, some scanners will misread it"
  encode_args=("$BYTE_MODE")
fi

if ! command -v qrencode >/dev/null; then
  print -r -u2 -- "$SCRIPT_NAME: qrencode not found (brew install qrencode, apt install qrencode)"
  exit 1
fi
if [[ -n $out && ( -e $out || -L $out ) ]]; then
  print -r -u2 -- "$SCRIPT_NAME: $out exists, refusing to overwrite"
  exit 1
fi

typeset password
[[ -t 0 ]] && print -rn -u2 -- "Password for $ssid: "
IFS= read -rs password || :   # EOF without a newline still fills the variable
[[ -t 0 ]] && print -u2
if [[ -z $password ]]; then
  print -r -u2 -- "$SCRIPT_NAME: empty password"
  exit 1
fi
validate_password "$password"

payload="WIFI:T:WPA;S:$(escape "$ssid");P:$(escape "$password");;"
if [[ -n $out ]]; then
  umask 077   # the png carries the password, and qrencode fopen()s at the ambient umask with no mode flag
  print -rn -- "$payload" | qrencode "${encode_args[@]}" -o "$out" -t PNG -l "$ERROR_CORRECTION" -s "$PNG_MODULE_SIZE"
  print -r -u2 -- "$SCRIPT_NAME: wrote $out, it carries the password in cleartext"
else
  draw_in_terminal "$payload"
fi
