# Matches the iTerm2 default profile.
window-width = 122
window-height = 29

# Position in points: horizontally centered, vertically between the top edge and the center.
window-position-x = 480
window-position-y = 120

font-family = "MesloLGS Nerd Font Mono"

bell-features = no-system,no-audio,no-attention,no-title,no-border

clipboard-read = allow

# Paste protection triggers on Espanso multi-line expansions.
clipboard-paste-protection = false

# Quit-only confirmation does not exist (1.4.0, discussion #4009), confirm-close-surface
# would also prompt on Cmd+W. A double Cmd+Q acts as the confirmation instead.
# The sequence has no timeout: any other key cancels it.
confirm-close-surface = false
keybind = super+q>super+q=quit

keybind = page_up=scroll_page_up
keybind = page_down=scroll_page_down

keybind = opt+backspace=text:\x1b\x7f

keybind = opt+delete=text:\x1bd

keybind = super+backspace=text:\x15

keybind = super+delete=text:\x0b

keybind = alt+up=text:\x1b<
keybind = alt+down=text:\x1b>

# The default super+ctrl+= is untypable on QWERTZ ("=" is shift+0).
keybind = super+ctrl+e=equalize_splits
